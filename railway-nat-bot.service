[Unit]
Description=Railway NAT VPS Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=natbot
WorkingDirectory=/opt/railway-nat-bot
EnvironmentFile=/etc/railway-nat-bot.env
ExecStart=/usr/bin/python3 /opt/railway-nat-bot/bot.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-write

[Install]
WantedBy=multi-user.target
